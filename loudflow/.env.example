# Copie este arquivo para .env.local e preencha com valores reais.
# Não commite .env.local.

# Supabase — obtido em https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email do admin inicial (usado pelo seed)
SEED_ADMIN_EMAIL=

# UTMify — leitura de métricas de campanha (só server-side, nunca NEXT_PUBLIC_)
UTMIFY_API_BASE_URL=
UTMIFY_API_TOKEN=
UTMIFY_DASHBOARD_ID=

# Segredo do endpoint de cron /api/cron/sync-utmify (Bearer)
UTMIFY_CRON_SECRET=

# EVO / W12 — webhook NewSale (POST /api/webhooks/evo/sales)
# EVO_WEBHOOK_SECRET vai no header customizado x-evo-webhook-secret.
# EVO_API_USERNAME/EVO_API_PASSWORD são Basic Auth do endpoint de detalhes
# da venda (GET /api/v2/sales/{IdRecord}). Nunca expor no browser.
EVO_WEBHOOK_SECRET=
EVO_API_USERNAME=
EVO_API_PASSWORD=
EVO_DEFAULT_ORGANIZATION_SLUG=loud-fit
# Opcional — só definir se a EVO trocar o host padrão
# EVO_API_BASE_URL=https://evo-integracao-api.w12app.com.br
# Opcional — só se quiser trocar o header do segredo
# EVO_WEBHOOK_SECRET_HEADER=x-evo-webhook-secret
