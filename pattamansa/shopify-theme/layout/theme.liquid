<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'pt-BR' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#141414">
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {% if template.name == 'index' %}
        PattaMansa &mdash; Camisetas premium para tutores de cachorro
      {% else %}
        {{ page_title }} &mdash; PattaMansa
      {% endif %}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="PattaMansa: camisetas premium para tutores de cachorro, com design autoral e padrao de qualidade Reserva INK.">
    {% endif %}
    <meta property="og:site_name" content="PattaMansa">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    {% if page_description %}
      <meta property="og:description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Pular para o conteudo</a>
    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
