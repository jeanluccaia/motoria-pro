<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'pt-BR' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.primary_color | default: '#3D5241' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon != blank %}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {% elsif settings.favicon_asset != blank %}
      <link rel="icon" href="{{ settings.favicon_asset | asset_url }}">
    {% else %}
      <link rel="icon" href="{{ 'pattamansa-favicon.png' | asset_url }}">
    {% endif %}

    <title>
      {% if template.name == 'index' %}
        PattaMansa &mdash; Camisetas premium para tutores de cachorro
      {% else %}
        {{ page_title }} &mdash; PattaMansa
      {% endif %}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% else %}
      <meta name="description" content="PattaMansa: camisetas premium para tutores de cachorro, com design autoral e padrao de qualidade Reserva INK.">
    {% endif %}
    <meta property="og:site_name" content="PattaMansa">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    {% if page_description %}
      <meta property="og:description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <style>
      :root {
        --ink: {{ settings.text_color | default: '#1A1A1A' }};
        --paper: {{ settings.background_color | default: '#F2EDE4' }};
        --clay: {{ settings.accent_color | default: '#F5A04A' }};
        --sage: {{ settings.primary_color | default: '#3D5241' }};
        --accent: {{ settings.support_color | default: '#B8BC8A' }};
        --font-display: {% if settings.heading_font != blank %}'{{ settings.heading_font.family }}', {% endif %}Georgia, 'Iowan Old Style', 'Palatino Linotype', serif;
        --font-body: {% if settings.body_font != blank %}'{{ settings.body_font.family }}', {% endif %}Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Pular para o conteudo</a>
    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% render 'cart-drawer' %}
  </body>
</html>
