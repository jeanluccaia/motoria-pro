{% assign quote_image = section.settings.image %}
{% assign quote_asset = section.settings.image_asset %}
{% assign image_alt = section.settings.image_alt | default: 'Camiseta PattaMansa vestida por tutor com cachorro' %}

<section class="emo" aria-label="Bloco emocional">
  <div class="page-width emo__inner">
    <div class="emo__copy">
      <p class="emo__quote">
        <span aria-hidden="true">&ldquo;</span>{{ section.settings.quote_before | default: 'O amor por um cachorro não cabe no peito.' }}<br>
        <em class="emo__accent">{{ section.settings.quote_accent | default: 'Então a gente veste.' }}</em><span aria-hidden="true">&rdquo;</span>
      </p>
      <p class="emo__text">{{ section.settings.text | default: 'Cada camiseta PattaMansa nasce da relação real entre tutor e cachorro. Não é estampa de pet shop — é peça do guarda-roupa que conta a sua história.' }}</p>
    </div>

    <div class="emo__media" aria-hidden="{% if quote_image == blank and quote_asset == blank %}true{% else %}false{% endif %}">
      {% if quote_image != blank %}
        {{ quote_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '520, 720, 900', sizes: '(min-width: 990px) 42vw, calc(100vw - 32px)', alt: image_alt, class: 'emo__img' }}
      {% elsif quote_asset != blank %}
        <img class="emo__img" src="{{ quote_asset | asset_url }}" alt="{{ image_alt | escape }}" loading="lazy" width="900" height="900">
      {% else %}
        <div class="emo__placeholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="M21 16l-5-5-9 9"/></svg>
          <span>Foto do tutor com o cachorro em camiseta PattaMansa</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .emo {
    background: var(--sage);
    color: var(--paper);
    padding-block: clamp(56px, 6vw, 96px);
  }

  .emo__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  .emo__copy {
    display: grid;
    gap: 18px;
  }

  .emo__quote {
    margin: 0;
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(26px, 3.6vw, 40px);
    line-height: 1.14;
    letter-spacing: -.005em;
    max-width: 520px;
  }

  .emo__accent {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 400;
    color: var(--clay);
    letter-spacing: 0;
  }

  .emo__text {
    margin: 0;
    max-width: 460px;
    color: rgba(242, 235, 224, .76);
    font-size: 15px;
    line-height: 1.55;
  }

  .emo__media {
    border-radius: 12px;
    background: rgba(11, 42, 33, .55);
    border: 1px solid rgba(242, 235, 224, .08);
    overflow: hidden;
    aspect-ratio: 4 / 3.4;
  }

  .emo__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .emo__placeholder {
    display: grid;
    place-items: center;
    gap: 10px;
    width: 100%;
    height: 100%;
    padding: 24px;
    color: rgba(242, 235, 224, .35);
    font-size: 12.5px;
    text-align: center;
  }

  .emo__placeholder svg {
    width: 32px;
    height: 32px;
  }

  @media (min-width: 760px) {
    .emo__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 48px;
    }

    .emo__media {
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 990px) {
    .emo__inner {
      gap: 72px;
    }
  }
</style>

{% schema %}
{
  "name": "Bloco emocional",
  "settings": [
    { "type": "textarea", "id": "quote_before", "label": "Quote (primeira linha)", "default": "O amor por um cachorro não cabe no peito." },
    { "type": "text", "id": "quote_accent", "label": "Destaque italic laranja", "default": "Então a gente veste." },
    { "type": "textarea", "id": "text", "label": "Texto de apoio", "default": "Cada camiseta PattaMansa nasce da relação real entre tutor e cachorro. Não é estampa de pet shop — é peça do guarda-roupa que conta a sua história." },
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "text", "id": "image_asset", "label": "Ou arquivo em assets" },
    { "type": "text", "id": "image_alt", "label": "Alt text", "default": "Camiseta PattaMansa vestida por tutor com cachorro" }
  ],
  "presets": [{ "name": "Bloco emocional" }]
}
{% endschema %}
