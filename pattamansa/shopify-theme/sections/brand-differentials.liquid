{%- comment -%}
  Bloco de confiança: 4 cards brancos com numeração no eyebrow.
{%- endcomment -%}
<section class="trust" aria-label="Nossos diferenciais">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="trust__heading">
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <ul class="trust__grid" role="list">
      <li class="trust__card">
        <span class="trust__num">01</span>
        <strong class="trust__title">{{ section.settings.item_1_title | default: 'Produção Reserva INK' }}</strong>
        <span class="trust__text">{{ section.settings.item_1_text | default: 'Malha premium e estampa que não desbota.' }}</span>
      </li>
      <li class="trust__card">
        <span class="trust__num">02</span>
        <strong class="trust__title">{{ section.settings.item_2_title | default: 'Envio com rastreio' }}</strong>
        <span class="trust__text">{{ section.settings.item_2_text | default: 'Acompanhe seu pedido do envio à porta.' }}</span>
      </li>
      <li class="trust__card">
        <span class="trust__num">03</span>
        <strong class="trust__title">{{ section.settings.item_3_title | default: 'Pagamento seguro' }}</strong>
        <span class="trust__text">{{ section.settings.item_3_text | default: 'Pix, cartão e checkout protegido.' }}</span>
      </li>
      <li class="trust__card">
        <span class="trust__num">04</span>
        <strong class="trust__title">{{ section.settings.item_4_title | default: 'Troca fácil' }}</strong>
        <span class="trust__text">{{ section.settings.item_4_text | default: 'Não serviu? A gente troca sem drama.' }}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .trust {
    background: var(--paper);
    padding-block: clamp(40px, 4.5vw, 72px);
  }

  .trust__heading {
    display: grid;
    gap: 6px;
    margin-bottom: 22px;
    text-align: center;
    justify-items: center;
  }

  .trust__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .trust__card {
    display: grid;
    gap: 6px;
    padding: 22px 20px;
    background: var(--card);
    border: 1px solid rgba(31, 25, 23, .08);
    border-radius: 12px;
    box-shadow: 0 6px 22px rgba(31, 25, 23, .04);
  }

  .trust__num {
    color: var(--clay);
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .1em;
  }

  .trust__title {
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.25;
  }

  .trust__text {
    color: rgba(31, 25, 23, .62);
    font-size: 13.5px;
    line-height: 1.45;
  }

  @media (min-width: 760px) {
    .trust__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }

    .trust__card {
      padding: 26px 22px;
      min-height: 152px;
    }

    .trust__title {
      font-size: 18px;
    }
  }
</style>

{% schema %}
{
  "name": "Bloco de confiança",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (opcional)" },
    { "type": "text", "id": "heading", "label": "Título (opcional)" },
    { "type": "text", "id": "item_1_title", "label": "Item 1 - título", "default": "Produção Reserva INK" },
    { "type": "text", "id": "item_1_text", "label": "Item 1 - texto", "default": "Malha premium e estampa que não desbota." },
    { "type": "text", "id": "item_2_title", "label": "Item 2 - título", "default": "Envio com rastreio" },
    { "type": "text", "id": "item_2_text", "label": "Item 2 - texto", "default": "Acompanhe seu pedido do envio à porta." },
    { "type": "text", "id": "item_3_title", "label": "Item 3 - título", "default": "Pagamento seguro" },
    { "type": "text", "id": "item_3_text", "label": "Item 3 - texto", "default": "Pix, cartão e checkout protegido." },
    { "type": "text", "id": "item_4_title", "label": "Item 4 - título", "default": "Troca fácil" },
    { "type": "text", "id": "item_4_text", "label": "Item 4 - texto", "default": "Não serviu? A gente troca sem drama." }
  ],
  "presets": [{ "name": "Bloco de confiança" }]
}
{% endschema %}
