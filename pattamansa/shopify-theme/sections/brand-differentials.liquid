{%- comment -%}
  Bloco de confiança: 4 cards logo após a personalização.
  Fundo claro (paper), cards em branco puro, borda verde suave,
  ícones simples inline. Sem excesso de texto.
{%- endcomment -%}
<section class="section section--warm section--trust">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="section-heading section-heading--center">
        <p class="eyebrow">Por que PattaMansa</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <ul class="trust-grid" role="list">
      <li class="trust-card">
        <span class="trust-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 8.4-7 9-4-.6-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
        </span>
        <strong>{{ section.settings.item_1_title | default: 'Produção Reserva INK' }}</strong>
        <span>{{ section.settings.item_1_text | default: 'Padrão premium consistente.' }}</span>
      </li>
      <li class="trust-card">
        <span class="trust-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
        </span>
        <strong>{{ section.settings.item_2_title | default: 'Envio com rastreio' }}</strong>
        <span>{{ section.settings.item_2_text | default: 'Do despacho até a entrega.' }}</span>
      </li>
      <li class="trust-card">
        <span class="trust-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/></svg>
        </span>
        <strong>{{ section.settings.item_3_title | default: 'Pagamento seguro' }}</strong>
        <span>{{ section.settings.item_3_text | default: 'Pix, cartão e boleto no Shopify.' }}</span>
      </li>
      <li class="trust-card">
        <span class="trust-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0 1 14-5.3"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-14 5.3"/><path d="M4 20v-4h4"/></svg>
        </span>
        <strong>{{ section.settings.item_4_title | default: 'Troca fácil' }}</strong>
        <span>{{ section.settings.item_4_text | default: '7 dias para trocar tamanho ou modelo.' }}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .section--trust {
    background: var(--paper);
  }

  .section--trust .section-heading--center {
    text-align: center;
    justify-items: center;
    margin-bottom: 30px;
  }

  .trust-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .trust-card {
    display: grid;
    gap: 6px;
    padding: 20px;
    background: #FFFFFF;
    border: 1px solid rgba(61, 82, 65, .18);
    border-radius: 12px;
    box-shadow: 0 6px 18px rgba(26, 26, 26, .06);
    text-align: left;
  }

  .trust-card__icon {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgba(61, 82, 65, .10);
    color: var(--sage);
    margin-bottom: 4px;
  }

  .trust-card__icon svg {
    width: 22px;
    height: 22px;
  }

  .trust-card strong {
    font-size: 15px;
    color: var(--ink);
    line-height: 1.25;
  }

  .trust-card > span:not(.trust-card__icon) {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.4;
  }

  @media (min-width: 760px) {
    .trust-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
    }

    .trust-card {
      padding: 24px;
    }

    .trust-card strong {
      font-size: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Bloco de confiança",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título (opcional)" },
    { "type": "text", "id": "item_1_title", "label": "Item 1 - título", "default": "Produção Reserva INK" },
    { "type": "text", "id": "item_1_text", "label": "Item 1 - texto", "default": "Padrão premium consistente." },
    { "type": "text", "id": "item_2_title", "label": "Item 2 - título", "default": "Envio com rastreio" },
    { "type": "text", "id": "item_2_text", "label": "Item 2 - texto", "default": "Do despacho até a entrega." },
    { "type": "text", "id": "item_3_title", "label": "Item 3 - título", "default": "Pagamento seguro" },
    { "type": "text", "id": "item_3_text", "label": "Item 3 - texto", "default": "Pix, cartão e boleto no Shopify." },
    { "type": "text", "id": "item_4_title", "label": "Item 4 - título", "default": "Troca fácil" },
    { "type": "text", "id": "item_4_text", "label": "Item 4 - texto", "default": "7 dias para trocar tamanho ou modelo." }
  ],
  "presets": [{ "name": "Bloco de confiança" }]
}
{% endschema %}
