{% assign fallback_collections = 'todas-as-camisetas|Todas as camisetas,caramelo-fc|Caramelo FC,matilha|Matilha,basicas-pattamansa|Basicas PattaMansa' | split: ',' %}

<section class="section section--collections">
  <div class="page-width">
    <div class="section-heading">
      <p class="eyebrow">Catalogo permanente</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="collection-grid">
      {% for block_index in (1..4) %}
        {% assign setting_key = 'collection_' | append: block_index %}
        {% assign configured_collection = collections[section.settings[setting_key]] %}
        {% assign fallback_item = fallback_collections[forloop.index0] | split: '|' %}
        {% assign handle = fallback_item[0] %}
        {% assign title = fallback_item[1] %}
        {% assign collection = configured_collection %}
        {% if collection == blank %}
          {% assign collection = collections[handle] %}
        {% endif %}
        {% if collection.url != blank %}
          {% assign collection_url = collection.url %}
        {% else %}
          {% assign collection_url = routes.collections_url | append: '/' | append: handle %}
        {% endif %}
        <a class="collection-card {% unless collection.featured_image %}collection-card--fallback{% endunless %}" href="{{ collection_url }}">
          {% if collection.featured_image %}
            {{ collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320, 520, 700', sizes: '(min-width: 900px) 25vw, 50vw', alt: collection.title }}
          {% endif %}
          <span>{{ collection.title | default: title }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colecoes em destaque",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Uma selecao enxuta para escolher sem ruido." },
    { "type": "collection", "id": "collection_1", "label": "Colecao 1" },
    { "type": "collection", "id": "collection_2", "label": "Colecao 2" },
    { "type": "collection", "id": "collection_3", "label": "Colecao 3" },
    { "type": "collection", "id": "collection_4", "label": "Colecao 4" }
  ],
  "presets": [{ "name": "Colecoes em destaque" }]
}
{% endschema %}
