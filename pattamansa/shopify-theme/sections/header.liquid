<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="{{ routes.root_url }}" aria-label="PattaMansa">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 220 | image_tag: loading: 'eager', widths: '120, 180, 220', class: 'brand__logo' }}
      {% else %}
        <img class="brand__logo" src="{{ 'pattamansa-logo.png' | asset_url }}" alt="PattaMansa" width="180" height="72" loading="eager">
      {% endif %}
    </a>

    <nav class="site-nav" aria-label="Menu principal">
      <a href="{{ routes.collections_url }}/todas-as-camisetas">Camisetas</a>
      <a href="{{ routes.collections_url }}">Cole&ccedil;&otilde;es</a>
      <a href="/pages/sobre">Sobre</a>
      <a href="/pages/faq">Ajuda</a>
    </nav>

    <details class="mobile-menu">
      <summary>Menu</summary>
      <nav aria-label="Menu mobile">
        <a href="{{ routes.collections_url }}/todas-as-camisetas">Camisetas</a>
        <a href="{{ routes.collections_url }}">Cole&ccedil;&otilde;es</a>
        <a href="/pages/sobre">Sobre</a>
        <a href="/pages/faq">Ajuda</a>
      </nav>
    </details>

    <a class="header-cart" href="{{ routes.cart_url }}" aria-label="Carrinho">
      Carrinho
      <span data-cart-count>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
