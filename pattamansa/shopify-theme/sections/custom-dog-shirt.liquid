{% assign desktop_image = section.settings.image_desktop %}
{% assign mobile_image = section.settings.image_mobile %}
{% assign desktop_asset_name = section.settings.desktop_asset | default: 'pattamansa-personalizacao-cachorro-desktop.webp' %}
{% assign mobile_asset_name = section.settings.mobile_asset %}
{% assign image_alt = section.settings.image_alt | default: 'Camiseta personalizada PattaMansa com estampa de cachorro ao lado do cachorro e do celular com a foto de referência' %}

{% assign cta_href = settings.whatsapp_url %}
{% if cta_href == blank %}
  {% assign cta_href = section.settings.whatsapp_url %}
{% endif %}
{% if cta_href == blank %}
  {% assign cta_href = '/pages/contato' %}
{% endif %}

{% assign cta_label = section.settings.cta_label | default: 'Personalizar no WhatsApp' %}
{% assign is_whatsapp = false %}
{% if cta_href contains 'wa.me' or cta_href contains 'whatsapp' %}
  {% assign is_whatsapp = true %}
{% endif %}

<section class="custom-dog-shirt" aria-labelledby="CustomDogShirtTitle-{{ section.id }}">
  <div class="page-width custom-dog-shirt__inner">
    <div class="custom-dog-shirt__copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="CustomDogShirtTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p class="custom-dog-shirt__text">{{ section.settings.text }}</p>

      <ul class="custom-dog-shirt__bullets" aria-label="Benefícios da personalização">
        <li>{{ section.settings.bullet_1 }}</li>
        <li>{{ section.settings.bullet_2 }}</li>
        <li>{{ section.settings.bullet_3 }}</li>
      </ul>

      {% if cta_href != blank %}
        <a
          class="custom-dog-shirt__button button"
          href="{{ cta_href }}"
          {% if is_whatsapp %}target="_blank" rel="noopener"{% endif %}
          aria-label="{{ cta_label | escape }}"
        >
          {{ cta_label }}
        </a>
      {% endif %}
    </div>

    <div class="custom-dog-shirt__media">
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1080 }} 1080w"
            sizes="calc(100vw - 32px)"
          >
        {% elsif mobile_asset_name != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_asset_name | asset_url }}"
            sizes="calc(100vw - 32px)"
          >
        {% endif %}

        {% if desktop_image != blank %}
          {{ desktop_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 56vw, calc(100vw - 32px)', alt: image_alt }}
        {% else %}
          <img
            src="{{ desktop_asset_name | asset_url }}"
            alt="{{ image_alt | escape }}"
            width="1680"
            height="900"
            loading="lazy"
          >
        {% endif %}
      </picture>
    </div>
  </div>
</section>

<style>
  .custom-dog-shirt {
    overflow: hidden;
    background: #3D5241;
    color: #fffaf2;
    padding-block: 88px;
  }

  .custom-dog-shirt__inner {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: 64px;
    align-items: center;
  }

  .custom-dog-shirt__copy {
    display: grid;
    gap: 20px;
    align-content: center;
    min-width: 0;
    padding-block: 24px;
  }

  .custom-dog-shirt .eyebrow {
    margin: 0;
    color: #F5A04A;
    letter-spacing: .12em;
  }

  .custom-dog-shirt h2 {
    max-width: 560px;
    color: #fffaf2;
    font-family: var(--font-display);
    font-size: 54px;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .custom-dog-shirt__text {
    max-width: 520px;
    margin: 0;
    color: rgba(255, 253, 248, .86);
    font-size: 19px;
    line-height: 1.55;
  }

  .custom-dog-shirt__bullets {
    display: grid;
    gap: 10px;
    max-width: 520px;
    margin: 4px 0 6px;
    padding-left: 20px;
    color: #fffaf2;
    font-weight: 700;
  }

  .custom-dog-shirt__bullets li::marker {
    color: #F5A04A;
  }

  .custom-dog-shirt__button {
    width: fit-content;
    min-width: 260px;
    margin-top: 6px;
    background: #F5A04A;
    color: #1A1A1A;
    border: 1px solid #F5A04A;
    box-shadow: 0 14px 34px rgba(0, 0, 0, .28);
    font-weight: 850;
  }

  .custom-dog-shirt__button:hover {
    transform: translateY(-1px);
    filter: brightness(1.04);
  }

  .custom-dog-shirt__button:focus-visible {
    outline: 3px solid #fffaf2;
    outline-offset: 3px;
  }

  .custom-dog-shirt__media {
    min-width: 0;
    border: 1px solid rgba(255, 253, 248, .16);
    border-radius: 8px;
    background: #fffaf2;
    box-shadow: 0 24px 70px rgba(0, 0, 0, .34);
    overflow: hidden;
  }

  .custom-dog-shirt__media picture {
    display: block;
    width: 100%;
  }

  .custom-dog-shirt__media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    object-fit: contain;
    object-position: center;
    background: #fffaf2;
  }

  @media (max-width: 989px) {
    .custom-dog-shirt {
      padding-block: 60px;
    }

    .custom-dog-shirt__inner {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .custom-dog-shirt__copy {
      padding-block: 8px;
    }

    .custom-dog-shirt h2 {
      max-width: 620px;
      font-size: 42px;
    }

    .custom-dog-shirt__text {
      font-size: 18px;
    }
  }

  @media (max-width: 749px) {
    .custom-dog-shirt {
      padding-block: 48px;
    }

    .custom-dog-shirt__inner {
      gap: 24px;
    }

    .custom-dog-shirt h2 {
      font-size: 34px;
      line-height: 1.08;
    }

    .custom-dog-shirt__text {
      font-size: 16px;
    }

    .custom-dog-shirt__bullets {
      gap: 9px;
      padding-left: 18px;
      font-size: 15px;
    }

    .custom-dog-shirt__button {
      width: 100%;
      min-width: 0;
      min-height: 52px;
      padding-inline: 14px;
    }

    .custom-dog-shirt__media {
      box-shadow: 0 18px 44px rgba(0, 0, 0, .28);
    }
  }
</style>

{% schema %}
{
  "name": "Personalização cachorro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Chamada curta", "default": "PERSONALIZAÇÃO" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Seu cachorro na sua camiseta." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Manda a foto no WhatsApp e a gente cria uma estampa exclusiva com a cara do seu melhor amigo." },
    { "type": "text", "id": "bullet_1", "label": "Bullet 1", "default": "Estampa exclusiva a partir da foto" },
    { "type": "text", "id": "bullet_2", "label": "Bullet 2", "default": "Produção com qualidade Reserva INK" },
    { "type": "text", "id": "bullet_3", "label": "Bullet 3", "default": "Atendimento direto pelo WhatsApp" },
    { "type": "text", "id": "cta_label", "label": "Texto do CTA", "default": "Personalizar no WhatsApp" },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "URL do WhatsApp (fallback local)",
      "info": "A URL global em Configurações do tema é usada primeiro. Se ambos vazios, cai para /pages/contato."
    },
    { "type": "image_picker", "id": "image_desktop", "label": "Imagem desktop" },
    { "type": "text", "id": "desktop_asset", "label": "Arquivo desktop em assets", "default": "pattamansa-personalizacao-cachorro-desktop.webp" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem mobile" },
    {
      "type": "text",
      "id": "mobile_asset",
      "label": "Arquivo mobile futuro em assets",
      "info": "Quando existir, preencher com pattamansa-personalizacao-cachorro-mobile.webp."
    },
    { "type": "text", "id": "image_alt", "label": "Alt text da imagem", "default": "Camiseta personalizada PattaMansa com estampa de cachorro ao lado do cachorro e do celular com a foto de referência" }
  ],
  "presets": [{ "name": "Personalização cachorro" }]
}
{% endschema %}
