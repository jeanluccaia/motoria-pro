{% assign desktop_image = section.settings.image_desktop %}
{% assign mobile_image = section.settings.image_mobile %}
{% assign desktop_asset_name = section.settings.desktop_asset | default: 'pattamansa-personalizacao-cachorro-desktop.webp' %}
{% assign mobile_asset_name = section.settings.mobile_asset %}
{% assign image_alt = section.settings.image_alt | default: 'Camiseta personalizada PattaMansa com estampa de cachorro ao lado do cachorro e do celular com a foto de referência' %}

{% assign cta_href = settings.whatsapp_url %}
{% if cta_href == blank %}
  {% assign cta_href = section.settings.whatsapp_url %}
{% endif %}
{% if cta_href == blank %}
  {% assign cta_href = '/pages/contato' %}
{% endif %}

{% assign cta_label = section.settings.cta_label | default: 'Personalizar no WhatsApp' %}
{% assign is_whatsapp = false %}
{% if cta_href contains 'wa.me' or cta_href contains 'whatsapp' %}
  {% assign is_whatsapp = true %}
{% endif %}

<section class="perso" aria-labelledby="PersoTitle-{{ section.id }}">
  <div class="page-width perso__inner">
    <div class="perso__media">
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1080 }} 1080w"
            sizes="calc(100vw - 32px)"
          >
        {% elsif mobile_asset_name != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_asset_name | asset_url }}"
            sizes="calc(100vw - 32px)"
          >
        {% endif %}

        {% if desktop_image != blank %}
          {{ desktop_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 46vw, calc(100vw - 32px)', alt: image_alt, class: 'perso__img' }}
        {% else %}
          <img
            class="perso__img"
            src="{{ desktop_asset_name | asset_url }}"
            alt="{{ image_alt | escape }}"
            width="1200"
            height="900"
            loading="lazy"
          >
        {% endif %}
      </picture>
    </div>

    <div class="perso__copy">
      <p class="eyebrow perso__eyebrow">{{ section.settings.eyebrow | default: 'PERSONALIZAÇÃO' }}</p>
      <h2 id="PersoTitle-{{ section.id }}" class="perso__title">{{ section.settings.heading | default: 'Seu cachorro na sua camiseta.' }}</h2>
      <p class="perso__text">{{ section.settings.text | default: 'Manda a foto no WhatsApp e a gente cria uma estampa exclusiva com a cara do seu melhor amigo.' }}</p>

      <ul class="perso__bullets" aria-label="Benefícios da personalização">
        <li>{{ section.settings.bullet_1 | default: 'Estampa exclusiva a partir da foto' }}</li>
        <li>{{ section.settings.bullet_2 | default: 'Produção com qualidade Reserva INK' }}</li>
        <li>{{ section.settings.bullet_3 | default: 'Atendimento direto pelo WhatsApp' }}</li>
      </ul>

      {% if cta_href != blank %}
        <a
          class="button button--primary perso__cta"
          href="{{ cta_href }}"
          {% if is_whatsapp %}target="_blank" rel="noopener"{% endif %}
          aria-label="{{ cta_label | escape }}"
        >
          {{ cta_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .perso {
    overflow: hidden;
    background: var(--sage);
    color: var(--paper);
    padding-block: clamp(48px, 6vw, 96px);
  }

  .perso__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  .perso__media {
    order: 1;
    border-radius: 12px;
    background: rgba(11, 42, 33, .6);
    border: 1px solid rgba(242, 235, 224, .08);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .perso__media picture,
  .perso__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .perso__copy {
    order: 2;
    display: grid;
    gap: 12px;
    align-content: center;
    min-width: 0;
  }

  .perso__eyebrow {
    margin: 0 0 4px;
    color: rgba(242, 235, 224, .58);
    letter-spacing: .18em;
    font-weight: 600;
  }

  .perso__title {
    margin: 0;
    max-width: 520px;
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 4.6vw, 48px);
    line-height: 1.04;
    letter-spacing: -0.01em;
  }

  .perso__text {
    margin: 0;
    max-width: 480px;
    color: rgba(242, 235, 224, .82);
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.55;
  }

  .perso__bullets {
    list-style: none;
    padding: 0;
    margin: 8px 0 4px;
    display: grid;
    gap: 10px;
    max-width: 500px;
  }

  .perso__bullets li {
    position: relative;
    padding-left: 30px;
    color: rgba(242, 235, 224, .92);
    font-size: 15px;
    font-weight: 500;
  }

  .perso__bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 4px;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--clay);
  }

  .perso__bullets li::after {
    content: "";
    position: absolute;
    left: 4.5px;
    top: 8.5px;
    width: 9px;
    height: 5px;
    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;
    transform: rotate(-45deg);
  }

  .perso__cta {
    justify-self: start;
    margin-top: 12px;
    min-width: 240px;
  }

  @media (min-width: 760px) {
    .perso__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 44px;
    }

    .perso__media {
      aspect-ratio: 4 / 3.4;
    }
  }

  @media (min-width: 990px) {
    .perso__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 64px;
    }
  }

  @media (max-width: 749px) {
    .perso__cta {
      width: 100%;
      min-width: 0;
      min-height: 52px;
    }

    .perso__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>

{% schema %}
{
  "name": "Personalização cachorro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Chamada curta", "default": "PERSONALIZAÇÃO" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Seu cachorro na sua camiseta." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Manda a foto no WhatsApp e a gente cria uma estampa exclusiva com a cara do seu melhor amigo." },
    { "type": "text", "id": "bullet_1", "label": "Bullet 1", "default": "Estampa exclusiva a partir da foto" },
    { "type": "text", "id": "bullet_2", "label": "Bullet 2", "default": "Produção com qualidade Reserva INK" },
    { "type": "text", "id": "bullet_3", "label": "Bullet 3", "default": "Atendimento direto pelo WhatsApp" },
    { "type": "text", "id": "cta_label", "label": "Texto do CTA", "default": "Personalizar no WhatsApp" },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "URL do WhatsApp (fallback local)",
      "info": "A URL global em Configurações do tema é usada primeiro. Se ambos vazios, cai para /pages/contato."
    },
    { "type": "image_picker", "id": "image_desktop", "label": "Imagem desktop" },
    { "type": "text", "id": "desktop_asset", "label": "Arquivo desktop em assets", "default": "pattamansa-personalizacao-cachorro-desktop.webp" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem mobile" },
    {
      "type": "text",
      "id": "mobile_asset",
      "label": "Arquivo mobile futuro em assets",
      "info": "Quando existir, preencher com pattamansa-personalizacao-cachorro-mobile.webp."
    },
    { "type": "text", "id": "image_alt", "label": "Alt text da imagem", "default": "Camiseta personalizada PattaMansa com estampa de cachorro ao lado do cachorro e do celular com a foto de referência" }
  ],
  "presets": [{ "name": "Personalização cachorro" }]
}
{% endschema %}
