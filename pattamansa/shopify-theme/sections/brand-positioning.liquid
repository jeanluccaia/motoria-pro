<section class="section section--positioning">
  <div class="page-width positioning-copy">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Posicionamento da marca",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Chamada curta", "default": "PattaMansa" },
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Camisetas premium para quem tem cachorro como familia." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Design autoral, acabamento bem resolvido e uma marca feita para tutores que vivem essa relacao de perto." }
  ],
  "presets": [{ "name": "Posicionamento da marca" }]
}
{% endschema %}
