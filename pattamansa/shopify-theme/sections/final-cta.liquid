{% assign whatsapp_url = settings.whatsapp_url %}
{% if whatsapp_url == blank %}
  {% assign whatsapp_url = section.settings.secondary_link %}
{% endif %}
{% if whatsapp_url == blank %}
  {% assign whatsapp_url = '/pages/contato' %}
{% endif %}

{% assign is_whatsapp = false %}
{% if whatsapp_url contains 'wa.me' or whatsapp_url contains 'whatsapp' %}
  {% assign is_whatsapp = true %}
{% endif %}

<section class="fcta" aria-label="Chamada final">
  <div class="page-width fcta__inner">
    <h2 class="fcta__title">{{ section.settings.heading | default: 'Vista esse amor.' }}</h2>
    <p class="fcta__sub">{{ section.settings.subheading | default: 'Escolha um modelo autoral ou crie a sua estampa com a cara do seu melhor amigo.' }}</p>

    <div class="fcta__actions">
      <a class="button button--primary" href="{{ section.settings.link | default: '/collections/todas-as-camisetas' }}">
        {{ section.settings.primary_label | default: 'Ver camisetas' }}
      </a>
      <a
        class="button fcta__ghost"
        href="{{ whatsapp_url }}"
        {% if is_whatsapp %}target="_blank" rel="noopener"{% endif %}
      >
        {{ section.settings.secondary_label | default: 'Personalizar com meu cachorro' }}
      </a>
    </div>
  </div>
</section>

<style>
  .fcta {
    background: var(--charcoal);
    color: var(--paper);
    padding-block: clamp(56px, 6vw, 88px);
  }

  .fcta__inner {
    display: grid;
    gap: 16px;
    justify-items: center;
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }

  .fcta__title {
    margin: 0;
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(32px, 4.8vw, 48px);
    line-height: 1.04;
    letter-spacing: -.01em;
  }

  .fcta__sub {
    margin: 0;
    max-width: 560px;
    color: rgba(242, 235, 224, .72);
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.5;
  }

  .fcta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 14px;
  }

  .fcta__actions .button {
    min-width: 220px;
  }

  .fcta__ghost {
    background: transparent;
    color: var(--paper);
    border: 1px solid rgba(242, 235, 224, .38);
  }

  .fcta__ghost:hover {
    background: rgba(242, 235, 224, .08);
    border-color: rgba(242, 235, 224, .6);
  }

  @media (max-width: 749px) {
    .fcta__actions {
      width: 100%;
      flex-direction: column;
    }

    .fcta__actions .button {
      width: 100%;
      min-width: 0;
      min-height: 52px;
    }
  }
</style>

{% schema %}
{
  "name": "CTA final",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Vista esse amor." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Escolha um modelo autoral ou crie a sua estampa com a cara do seu melhor amigo." },
    { "type": "text", "id": "primary_label", "label": "CTA principal", "default": "Ver camisetas" },
    { "type": "url", "id": "link", "label": "Link CTA principal" },
    { "type": "text", "id": "secondary_label", "label": "CTA secundário", "default": "Personalizar com meu cachorro" },
    { "type": "url", "id": "secondary_link", "label": "Link CTA secundário (fallback WhatsApp)" }
  ],
  "presets": [{ "name": "CTA final" }]
}
{% endschema %}
