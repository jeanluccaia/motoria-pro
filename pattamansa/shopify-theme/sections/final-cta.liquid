<section class="section final-cta">
  <div class="page-width final-cta__inner">
    <h2>{{ section.settings.heading }}</h2>
    <a class="button button--primary" href="{{ section.settings.link }}">Ver camisetas</a>
  </div>
</section>

{% schema %}
{
  "name": "CTA final",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Escolha sua camiseta" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "CTA final" }]
}
{% endschema %}
