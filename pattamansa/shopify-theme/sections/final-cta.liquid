{% assign whatsapp_url = settings.whatsapp_url %}
{% if whatsapp_url == blank %}
  {% assign whatsapp_url = section.settings.secondary_link %}
{% endif %}
{% if whatsapp_url == blank %}
  {% assign whatsapp_url = '/pages/contato' %}
{% endif %}

{% assign is_whatsapp = false %}
{% if whatsapp_url contains 'wa.me' or whatsapp_url contains 'whatsapp' %}
  {% assign is_whatsapp = true %}
{% endif %}

<section class="section final-cta">
  <div class="page-width final-cta__inner">
    <p class="eyebrow final-cta__eyebrow">{{ section.settings.eyebrow | default: 'PattaMansa' }}</p>
    <h2>{{ section.settings.heading | default: 'Vista a matilha.' }}</h2>
    <p class="final-cta__sub">{{ section.settings.subheading | default: 'Escolha uma estampa pronta ou personalize uma camiseta com a cara do seu cachorro.' }}</p>

    <div class="final-cta__actions">
      <a class="button button--primary" href="{{ section.settings.link | default: '/collections/todas-as-camisetas' }}">
        {{ section.settings.primary_label | default: 'Ver camisetas' }}
      </a>
      <a
        class="button button--ghost-light"
        href="{{ whatsapp_url }}"
        {% if is_whatsapp %}target="_blank" rel="noopener"{% endif %}
      >
        {{ section.settings.secondary_label | default: 'Personalizar a minha' }}
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: #3D5241;
    color: #fffaf2;
    text-align: center;
  }

  .final-cta__inner {
    display: grid;
    gap: 14px;
    justify-items: center;
    max-width: 720px;
    margin-inline: auto;
  }

  .final-cta .final-cta__eyebrow {
    color: #F5A04A;
    margin: 0;
  }

  .final-cta h2 {
    max-width: 620px;
    color: #fffaf2;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.04;
    text-align: center;
  }

  .final-cta__sub {
    max-width: 560px;
    margin: 0;
    color: rgba(255, 253, 248, .84);
    font-size: 18px;
    line-height: 1.5;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }

  .final-cta__actions .button {
    min-width: 220px;
  }

  .final-cta .button--ghost-light {
    background: transparent;
    color: #fffaf2;
    border: 1px solid rgba(255, 253, 248, .55);
  }

  .final-cta .button--ghost-light:hover {
    background: rgba(255, 253, 248, .08);
  }

  @media (max-width: 749px) {
    .final-cta__actions {
      width: 100%;
    }

    .final-cta__actions .button {
      width: 100%;
      min-width: 0;
    }
  }
</style>

{% schema %}
{
  "name": "CTA final",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Chamada curta", "default": "PattaMansa" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Vista a matilha." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Escolha uma estampa pronta ou personalize uma camiseta com a cara do seu cachorro." },
    { "type": "text", "id": "primary_label", "label": "CTA principal", "default": "Ver camisetas" },
    { "type": "url", "id": "link", "label": "Link CTA principal" },
    { "type": "text", "id": "secondary_label", "label": "CTA secundário", "default": "Personalizar a minha" },
    { "type": "url", "id": "secondary_link", "label": "Link CTA secundário (fallback WhatsApp)" }
  ],
  "presets": [{ "name": "CTA final" }]
}
{% endschema %}
