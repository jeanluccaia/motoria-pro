{% assign has_real_proof = false %}
{% for block in section.blocks %}
  {% if block.settings.image != blank or block.settings.text != blank %}
    {% assign has_real_proof = true %}
  {% endif %}
{% endfor %}

{% if section.settings.show_section %}
  <section class="section section--proof">
    <div class="page-width">
      <div class="section-heading section-heading--center">
        <p class="eyebrow">Comunidade</p>
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="proof-sub">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>

      {% if has_real_proof %}
        <div class="proof-grid">
          {% for block in section.blocks %}
            {% if block.settings.image != blank or block.settings.text != blank %}
              <figure class="proof-card" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320, 520, 700', alt: block.settings.text }}
                {% endif %}
                {% if block.settings.text != blank %}
                  <figcaption>{{ block.settings.text }}</figcaption>
                {% endif %}
              </figure>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

<style>
  .section--proof .section-heading--center {
    text-align: center;
    justify-items: center;
  }

  .section--proof .proof-sub {
    max-width: 560px;
    margin: 6px auto 0;
    color: var(--muted);
    font-size: 17px;
  }

  .section--proof .section-heading {
    margin-bottom: 12px;
  }
</style>

{% schema %}
{
  "name": "Prova social",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Mostrar seção", "default": true },
    { "type": "text", "id": "heading", "label": "Título", "default": "Quem veste, recomenda." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline (opcional)", "default": "Uma marca feita para tutores que tratam cachorro como família." }
  ],
  "blocks": [
    {
      "type": "depoimento",
      "name": "Foto/depoimento",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "textarea", "id": "text", "label": "Depoimento" }
      ]
    }
  ],
  "presets": [{ "name": "Prova social" }]
}
{% endschema %}
