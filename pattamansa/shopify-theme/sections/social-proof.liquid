<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <p class="eyebrow">Comunidade</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <div class="proof-grid">
      {% for block in section.blocks %}
        <figure class="proof-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320, 520, 700' }}
          {% endif %}
          <figcaption>{{ block.settings.text }}</figcaption>
        </figure>
      {% else %}
        <div class="proof-placeholder">Espaco reservado para fotos e depoimentos reais de clientes.</div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Prova social",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titulo", "default": "Quem veste, leva uma historia junto." }
  ],
  "blocks": [
    {
      "type": "depoimento",
      "name": "Foto/depoimento",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagem" },
        { "type": "textarea", "id": "text", "label": "Depoimento", "default": "Depoimento de cliente" }
      ]
    }
  ],
  "presets": [{ "name": "Prova social" }]
}
{% endschema %}
