{% assign banner_mode = section.settings.banner_mode | default: 'split_right' %}
{% assign image_alt = section.settings.image_alt | default: 'Fundadores da PattaMansa com cachorro' %}

{% assign desktop_image = section.settings.image_desktop %}
{% if desktop_image == blank %}
  {% assign desktop_image = section.settings.image %}
{% endif %}
{% assign mobile_image = section.settings.image_mobile %}

{% assign desktop_asset_name = section.settings.desktop_asset | default: 'pattamansa-hero-fundadores-clean-desktop.webp' %}
{% assign mobile_asset_name = section.settings.mobile_asset | default: 'pattamansa-hero-fundadores-clean-mobile.webp' %}
{% assign desktop_asset_fallback = section.settings.desktop_asset_fallback | default: 'pattamansa-hero-fundadores-desktop.webp' %}

{% assign primary_link = section.settings.primary_link | default: '/collections/todas-as-camisetas' %}
{% assign primary_label = section.settings.primary_label | default: 'Ver camisetas' %}
{% assign secondary_label = section.settings.secondary_label | default: 'Personalizar com meu cachorro' %}

{% assign whatsapp_url = settings.whatsapp_url %}
{% if whatsapp_url == blank %}
  {% assign whatsapp_url = section.settings.secondary_link %}
{% endif %}
{% if whatsapp_url == blank %}
  {% assign whatsapp_url = '/pages/contato' %}
{% endif %}

{% assign is_whatsapp = false %}
{% if whatsapp_url contains 'wa.me' or whatsapp_url contains 'whatsapp' %}
  {% assign is_whatsapp = true %}
{% endif %}

{% assign full_image_link = section.settings.primary_link %}
{% assign full_image_label = primary_label %}

<section class="hero-premium hero-premium--{{ banner_mode }}">
  {% if banner_mode == 'split_right' %}
    <div class="page-width hero-premium__split">
      <div class="hero-premium__copy hero-premium__copy--split">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1>{{ section.settings.heading | default: 'Pra quem tem cachorro como família.' }}</h1>
        <p class="hero-premium__sub">{{ section.settings.subheading | default: 'Camisetas premium e personalizadas para tutores que carregam esse amor no peito.' }}</p>
        <div class="button-row">
          <a class="button button--primary" href="{{ primary_link }}">{{ primary_label }}</a>
          <a
            class="button button--outline-sage"
            href="{{ whatsapp_url }}"
            {% if is_whatsapp %}target="_blank" rel="noopener"{% endif %}
          >
            {{ secondary_label }}
          </a>
        </div>
      </div>

      <div class="hero-premium__media hero-premium__media--split">
        <picture>
          {% if mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1080 }} 1080w"
              sizes="100vw"
            >
          {% elsif mobile_asset_name != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ mobile_asset_name | asset_url }}"
              sizes="100vw"
            >
          {% endif %}
          {% if desktop_image != blank %}
            {{ desktop_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: image_alt }}
          {% else %}
            <img
              class="hero-premium__img"
              src="{{ desktop_asset_name | asset_url }}"
              alt="{{ image_alt | escape }}"
              width="1536"
              height="1024"
              loading="eager"
              fetchpriority="high"
              onerror="if(this.dataset.fallback && this.src !== this.dataset.fallback){this.src=this.dataset.fallback;}"
              data-fallback="{{ desktop_asset_fallback | asset_url }}"
            >
          {% endif %}
        </picture>
      </div>
    </div>

  {% elsif banner_mode == 'text_over_image' %}
    <div class="hero-premium__media">
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1080 }} 1080w"
            sizes="100vw"
          >
        {% endif %}
        {% if desktop_image != blank %}
          {{ desktop_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '375, 750, 1100, 1500, 1800', sizes: '100vw', alt: image_alt }}
        {% else %}
          <img
            src="{{ desktop_asset_name | asset_url }}"
            alt="{{ image_alt | escape }}"
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </picture>
    </div>
    <div class="hero-premium__overlay" aria-hidden="true"></div>
    <div class="page-width hero-premium__content hero-premium__content--overlay">
      <div class="hero-premium__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1>{{ section.settings.heading | default: 'Pra quem tem cachorro como família.' }}</h1>
        <p>{{ section.settings.subheading | default: 'Camisetas premium com design de verdade.' }}</p>
        <div class="button-row">
          <a class="button button--primary" href="{{ primary_link }}">{{ primary_label }}</a>
          <a class="button button--ghost" href="{{ whatsapp_url }}"{% if is_whatsapp %} target="_blank" rel="noopener"{% endif %}>{{ secondary_label }}</a>
        </div>
      </div>
    </div>

  {% elsif banner_mode == 'full_image' %}
    <div class="hero-premium__media">
      {% if full_image_link != blank %}
        <a class="hero-premium__media-link" href="{{ full_image_link }}" aria-label="{{ full_image_label | escape }}">
      {% endif %}
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1080 }} 1080w"
            sizes="100vw"
          >
        {% endif %}
        {% if desktop_image != blank %}
          {{ desktop_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '375, 750, 1100, 1500, 1800', sizes: '100vw', alt: image_alt }}
        {% else %}
          <img
            src="{{ desktop_asset_name | asset_url }}"
            alt="{{ image_alt | escape }}"
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </picture>
      {% if full_image_link != blank %}
        </a>
      {% endif %}
    </div>

  {% else %}
    <div class="page-width hero-premium__content">
      <div class="hero-premium__copy">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.subheading }}</p>
        <div class="button-row">
          <a class="button button--primary" href="{{ primary_link }}">{{ primary_label }}</a>
          <a class="button button--secondary" href="{{ whatsapp_url }}">{{ secondary_label }}</a>
        </div>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero premium",
  "settings": [
    {
      "type": "select",
      "id": "banner_mode",
      "label": "Modo do banner",
      "default": "split_right",
      "options": [
        { "value": "split_right", "label": "Texto à esquerda, imagem à direita (recomendado)" },
        { "value": "text_over_image", "label": "Imagem com texto HTML sobreposto" },
        { "value": "full_image", "label": "Imagem completa com copy no arquivo" },
        { "value": "split_copy", "label": "Textos do tema" }
      ]
    },
    { "type": "image_picker", "id": "image_desktop", "label": "Banner desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Banner mobile" },
    {
      "type": "text",
      "id": "desktop_asset",
      "label": "Arquivo desktop em assets",
      "default": "pattamansa-hero-fundadores-clean-desktop.webp",
      "info": "Imagem limpa (sem texto embutido). Se não existir, cai automaticamente para o fallback."
    },
    {
      "type": "text",
      "id": "mobile_asset",
      "label": "Arquivo mobile em assets",
      "default": "pattamansa-hero-fundadores-clean-mobile.webp",
      "info": "Imagem mobile limpa. Se não existir, usa o fallback desktop."
    },
    {
      "type": "text",
      "id": "desktop_asset_fallback",
      "label": "Fallback desktop",
      "default": "pattamansa-hero-fundadores-desktop.webp"
    },
    { "type": "image_picker", "id": "image", "label": "Imagem de fundo fallback (uploader)" },
    { "type": "text", "id": "image_alt", "label": "Alt text da imagem", "default": "Fundadores da PattaMansa com cachorro" },
    { "type": "text", "id": "eyebrow", "label": "Chamada curta", "default": "Pet lifestyle premium" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Pra quem tem cachorro como família." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Camisetas premium e personalizadas para tutores que carregam esse amor no peito." },
    { "type": "text", "id": "primary_label", "label": "CTA principal", "default": "Ver camisetas" },
    { "type": "url", "id": "primary_link", "label": "Link CTA principal" },
    { "type": "text", "id": "secondary_label", "label": "CTA secundário", "default": "Personalizar com meu cachorro" },
    { "type": "url", "id": "secondary_link", "label": "Link CTA secundário (fallback se WhatsApp global vazio)" }
  ],
  "presets": [{ "name": "Hero premium" }]
}
{% endschema %}
