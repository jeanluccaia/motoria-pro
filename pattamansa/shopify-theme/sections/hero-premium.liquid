{% assign desktop_image = section.settings.image_desktop %}
{% if desktop_image == blank %}
  {% assign desktop_image = section.settings.image %}
{% endif %}
{% assign mobile_image = section.settings.image_mobile %}
{% assign banner_mode = section.settings.banner_mode | default: 'text_over_image' %}
{% assign image_alt = section.settings.image_alt | default: 'Fundadores da PattaMansa com cachorro em banner da marca' %}
{% assign desktop_asset_name = section.settings.desktop_asset | default: 'pattamansa-hero-fundadores-desktop.webp' %}
{% assign default_desktop_asset = desktop_asset_name | asset_url %}
{% assign full_image_link = section.settings.primary_link %}
{% assign full_image_link_label = section.settings.primary_label | default: 'Ver camisetas' %}

{% assign primary_link = section.settings.primary_link | default: '/collections/todas-as-camisetas' %}
{% assign primary_label = section.settings.primary_label | default: 'Ver camisetas' %}
{% assign secondary_label = section.settings.secondary_label | default: 'Personalizar com a foto do meu cão' %}

{% assign whatsapp_url = settings.whatsapp_url %}
{% if whatsapp_url == blank %}
  {% assign whatsapp_url = section.settings.secondary_link %}
{% endif %}
{% if whatsapp_url == blank %}
  {% assign whatsapp_url = '/pages/contato' %}
{% endif %}

{% assign has_hero_image = true %}
{% if desktop_image == blank and default_desktop_asset == blank %}
  {% assign has_hero_image = false %}
{% endif %}

<section class="hero-premium hero-premium--{{ banner_mode }} {% unless has_hero_image %}hero-premium--fallback{% endunless %}">
  {% if has_hero_image %}
    <div class="hero-premium__media">
      {% if banner_mode == 'full_image' and full_image_link != blank %}
        <a class="hero-premium__media-link" href="{{ full_image_link }}" aria-label="{{ full_image_link_label | escape }}">
      {% endif %}
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1080 }} 1080w"
            sizes="100vw"
          >
        {% endif %}
        {% if desktop_image != blank %}
          {{ desktop_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '375, 750, 1100, 1500, 1800', sizes: '100vw', alt: image_alt }}
        {% else %}
          <img
            src="{{ default_desktop_asset }}"
            alt="{{ image_alt | escape }}"
            width="1536"
            height="1024"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </picture>
      {% if banner_mode == 'full_image' and full_image_link != blank %}
        </a>
      {% endif %}
    </div>
  {% endif %}

  {% if banner_mode == 'text_over_image' %}
    <div class="hero-premium__overlay" aria-hidden="true"></div>
    <div class="page-width hero-premium__content hero-premium__content--overlay">
      <div class="hero-premium__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h1>{{ section.settings.heading | default: 'Pra quem tem cachorro como família.' }}</h1>
        <p>{{ section.settings.subheading | default: 'Camisetas premium com design de verdade.' }}</p>
        <div class="button-row">
          <a class="button button--primary" href="{{ primary_link }}">{{ primary_label }}</a>
          <a class="button button--ghost" href="{{ whatsapp_url }}"{% if whatsapp_url contains 'wa.me' or whatsapp_url contains 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>{{ secondary_label }}</a>
        </div>
      </div>
    </div>
  {% elsif banner_mode != 'full_image' %}
    <div class="page-width hero-premium__content">
      <div class="hero-premium__copy">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h1>{{ section.settings.heading }}</h1>
        <p>{{ section.settings.subheading }}</p>
        <div class="button-row">
          <a class="button button--primary" href="{{ primary_link }}">{{ primary_label }}</a>
          <a class="button button--secondary" href="{{ whatsapp_url }}">{{ secondary_label }}</a>
        </div>
      </div>

      {% unless has_hero_image %}
        <div class="hero-premium__panel" aria-hidden="true">
          {% render 'icon-paw-heart' %}
        </div>
      {% endunless %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Hero premium",
  "settings": [
    {
      "type": "select",
      "id": "banner_mode",
      "label": "Modo do banner",
      "default": "text_over_image",
      "options": [
        { "value": "text_over_image", "label": "Imagem com texto HTML sobreposto (recomendado)" },
        { "value": "full_image", "label": "Imagem completa com copy no arquivo" },
        { "value": "split_copy", "label": "Imagem com textos do tema" }
      ]
    },
    { "type": "image_picker", "id": "image_desktop", "label": "Banner desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Banner mobile" },
    { "type": "text", "id": "desktop_asset", "label": "Arquivo desktop em assets", "default": "pattamansa-hero-fundadores-desktop.webp" },
    { "type": "image_picker", "id": "image", "label": "Imagem de fundo fallback" },
    { "type": "text", "id": "image_alt", "label": "Alt text da imagem", "default": "Fundadores da PattaMansa com cachorro em banner da marca" },
    { "type": "text", "id": "eyebrow", "label": "Chamada curta", "default": "Pet lifestyle premium" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Pra quem tem cachorro como família." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Camisetas premium com design de verdade." },
    { "type": "text", "id": "primary_label", "label": "CTA principal", "default": "Ver camisetas" },
    { "type": "url", "id": "primary_link", "label": "Link CTA principal" },
    { "type": "text", "id": "secondary_label", "label": "CTA secundário", "default": "Personalizar com a foto do meu cão" },
    { "type": "url", "id": "secondary_link", "label": "Link CTA secundário (fallback se WhatsApp global vazio)" }
  ],
  "presets": [{ "name": "Hero premium" }]
}
{% endschema %}
