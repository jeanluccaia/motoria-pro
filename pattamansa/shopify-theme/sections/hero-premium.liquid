{% assign desktop_image = section.settings.image_desktop %}
{% if desktop_image == blank %}
  {% assign desktop_image = section.settings.image %}
{% endif %}
{% assign mobile_image = section.settings.image_mobile %}

<section class="hero-premium {% if desktop_image == blank %}hero-premium--fallback{% endif %}">
  {% if desktop_image != blank %}
    <div class="hero-premium__media">
      <picture>
        {% if mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1080 }} 1080w"
            sizes="100vw"
          >
        {% endif %}
        {{ desktop_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '375, 750, 1100, 1500, 1800', sizes: '100vw', alt: section.settings.heading }}
      </picture>
    </div>
  {% endif %}
  <div class="page-width hero-premium__content">
    <div class="hero-premium__copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <div class="button-row">
        <a class="button button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      </div>
    </div>

    {% unless desktop_image != blank %}
      <div class="hero-premium__panel" aria-hidden="true">
        {% render 'icon-paw-heart' %}
      </div>
    {% endunless %}
  </div>
</section>

{% schema %}
{
  "name": "Hero premium",
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Banner desktop" },
    { "type": "image_picker", "id": "image_mobile", "label": "Banner mobile" },
    { "type": "image_picker", "id": "image", "label": "Imagem de fundo fallback" },
    { "type": "text", "id": "eyebrow", "label": "Chamada curta", "default": "Pet lifestyle premium" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Pra quem tem cachorro como familia." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Camisetas premium com design de verdade — feitas no padrao Reserva INK." },
    { "type": "text", "id": "primary_label", "label": "CTA principal", "default": "Ver camisetas" },
    { "type": "url", "id": "primary_link", "label": "Link CTA principal" },
    { "type": "text", "id": "secondary_label", "label": "CTA secundario", "default": "Conhecer a marca" },
    { "type": "url", "id": "secondary_link", "label": "Link CTA secundario" }
  ],
  "presets": [{ "name": "Hero premium" }]
}
{% endschema %}
