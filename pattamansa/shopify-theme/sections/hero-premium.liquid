<section class="hero-premium {% if section.settings.image == blank %}hero-premium--fallback{% endif %}">
  {% if section.settings.image != blank %}
    <div class="hero-premium__media">
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '375, 750, 1100, 1500, 1800', sizes: '100vw', alt: section.settings.heading }}
    </div>
  {% endif %}
  <div class="page-width hero-premium__content">
    <div class="hero-premium__copy">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
      <div class="button-row">
        <a class="button button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      </div>
    </div>

    {% if section.settings.image != blank %}
      <span></span>
    {% else %}
      <div class="hero-premium__panel" aria-hidden="true">
        <div class="hero-premium__tag">PattaMansa</div>
        <div class="hero-premium__shirt">
          <span>PM</span>
        </div>
        <p>Camisetas premium para tutores.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero premium",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem de fundo" },
    { "type": "text", "id": "eyebrow", "label": "Chamada curta", "default": "Pet lifestyle premium" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Pra quem tem cachorro como familia." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Camisetas premium com design de verdade — feitas no padrao Reserva INK." },
    { "type": "text", "id": "primary_label", "label": "CTA principal", "default": "Ver camisetas" },
    { "type": "url", "id": "primary_link", "label": "Link CTA principal" },
    { "type": "text", "id": "secondary_label", "label": "CTA secundario", "default": "Conhecer a marca" },
    { "type": "url", "id": "secondary_link", "label": "Link CTA secundario" }
  ],
  "presets": [{ "name": "Hero premium" }]
}
{% endschema %}
