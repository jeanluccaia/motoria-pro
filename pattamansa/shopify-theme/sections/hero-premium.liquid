<section class="hero-premium">
  <div class="hero-premium__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '375, 750, 1100, 1500, 1800', sizes: '100vw' }}
    {% endif %}
  </div>
  <div class="page-width hero-premium__content">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    <div class="button-row">
      <a class="button button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
      <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero premium",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem de fundo" },
    { "type": "text", "id": "eyebrow", "label": "Chamada curta", "default": "Pet lifestyle premium" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Vista o amor pelo seu cachorro." },
    { "type": "textarea", "id": "subheading", "label": "Subheadline", "default": "Camisetas premium para tutores que carregam essa relacao no peito." },
    { "type": "text", "id": "primary_label", "label": "CTA principal", "default": "Ver camisetas" },
    { "type": "url", "id": "primary_link", "label": "Link CTA principal" },
    { "type": "text", "id": "secondary_label", "label": "CTA secundario", "default": "Conhecer a PattaMansa" },
    { "type": "url", "id": "secondary_link", "label": "Link CTA secundario" }
  ],
  "presets": [{ "name": "Hero premium" }]
}
{% endschema %}
