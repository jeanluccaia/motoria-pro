<section class="cart-page page-width">
  <h1>Seu carrinho</h1>

  {% if cart.item_count == 0 %}
    <div class="empty-state">
      <p>Seu carrinho esta vazio.</p>
      <a class="button button--primary" href="{{ routes.collections_url }}/camisetas-para-tutores">Ver camisetas</a>
    </div>
  {% else %}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="cart-lines">
        {% for item in cart.items %}
          <article class="cart-line">
            <a class="cart-line__image" href="{{ item.url }}">
              {% if item.image %}
                {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240' }}
              {% endif %}
            </a>
            <div class="cart-line__body">
              <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {% unless item.product.has_only_default_variant %}
                <ul class="cart-line__options">
                  {% for option in item.options_with_values %}
                    <li>{{ option.name }}: {{ option.value }}</li>
                  {% endfor %}
                </ul>
              {% endunless %}
              <label>
                Quantidade
                <input class="quantity-input" type="number" min="0" name="updates[]" value="{{ item.quantity }}">
              </label>
            </div>
            <p class="cart-line__price">{{ item.final_line_price | money }}</p>
          </article>
        {% endfor %}
      </div>

      <div class="cart-summary">
        <p><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></p>
        <small>Frete e pagamento sao calculados no checkout Shopify.</small>
        <button class="button button--secondary" type="submit" name="update">Atualizar carrinho</button>
        <button class="button button--primary" type="submit" name="checkout">Finalizar compra</button>
      </div>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Carrinho",
  "settings": []
}
{% endschema %}
