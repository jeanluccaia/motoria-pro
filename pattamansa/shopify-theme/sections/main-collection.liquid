<section class="collection-page page-width">
  <div class="collection-header">
    <p class="eyebrow">PattaMansa</p>
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="rte">{{ collection.description }}</div>
    {% endif %}
  </div>

  {% paginate collection.products by 24 %}
    <div class="product-grid">
      {% for product in collection.products %}
        <a class="product-card" href="{{ product.url }}">
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320, 520, 700', sizes: '(min-width: 900px) 25vw, 50vw', alt: product.title }}
          {% endif %}
          {% unless product.available %}
            <span class="product-card__badge">Esgotado</span>
          {% endunless %}
          <span class="product-card__title">{{ product.title }}</span>
          <span class="product-card__price">
            {% if product.price > 0 %}
              {% if product.compare_at_price > product.price %}
                <s>{{ product.compare_at_price | money }}</s>
              {% endif %}
              {{ product.price | money }}
            {% else %}
              Em breve
            {% endif %}
          </span>
          <span class="product-card__cta">Escolher</span>
        </a>
      {% else %}
        <p class="empty-state">Colecao pronta para receber produtos.</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav class="pagination" role="navigation" aria-label="Paginacao">
        {{ paginate | default_pagination }}
      </nav>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Colecao principal",
  "settings": []
}
{% endschema %}
