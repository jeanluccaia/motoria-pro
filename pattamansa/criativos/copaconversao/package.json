{
  "name": "pattamansa-copaconversao",
  "version": "1.0.0",
  "description": "Remotion criativo de conversão — Copa 2026 / Caramelo FC",
  "scripts": {
    "start": "npx remotion studio src/Root.tsx",
    "render": "npx remotion render PattaMansa_CopaConversao out/pattamansa_copa_conversao.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --enforce-audio-track",
